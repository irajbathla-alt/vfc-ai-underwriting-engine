function vfcBiqDetectBank_(text,row){const s=(String(row.bankName||'')+'\n'+String(text||'').substring(0,8000)).toUpperCase();if(/TD CANADA TRUST|TORONTO[- ]DOMINION|THE TORONTO-DOMINION BANK/.test(s))return'TD';if(/ROYAL BANK OF CANADA|\bRBC\b/.test(s))return'RBC';if(/BANK OF MONTREAL|\bBMO\b/.test(s))return'BMO';if(/SCOTIABANK|BANK OF NOVA SCOTIA/.test(s))return'SCOTIA';if(/CIBC|CANADIAN IMPERIAL BANK OF COMMERCE/.test(s))return'CIBC';if(/ATB FINANCIAL/.test(s))return'ATB';if(/NATIONAL BANK OF CANADA|BANQUE NATIONALE/.test(s))return'NBC';return'GENERIC';}

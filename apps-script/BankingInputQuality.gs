function vfcBiqParseTdOpeningClosingFromText_(text){const lines=String(text||'').split(/\r?\n/);let o=null,c=null;lines.forEach(function(raw){const line=String(raw||'').replace(/\u00a0/g,' ').replace(/\s+/g,' ').trim();if(!line)return;if(o===null&&/BALANCE\s+FORWARD/i.test(line)){const m=line.match(/BALANCE\s+FORWARD\s+[A-Z]{3}\s*\d{1,2}\s+([0-9,]+\.\d{2})(OD)?/i);if(m){o=vfcBiqNumber_(m[1]);if(m[2])o=-Math.abs(o);}}const dm=line.match(/\b(?:JAN|FEB|MAR|APR|MAY|JUN|JUL|AUG|SEP|SEPT|OCT|NOV|DEC)\s*\d{1,2}\b/i);if(dm){const t=line.substring((dm.index||0)+dm[0].length).match(/([0-9,]+\.\d{2})(OD)?\s*$/);if(t){c=vfcBiqNumber_(t[1]);if(t[2])c=-Math.abs(c);}}});return{openingBalance:o,closingBalance:c};}
function vfcBiqExtractAndReconcileTotalsWithOpenAI_(text,row,bank){if(typeof callOpenAIJson_!=='function')return{verified:false,reason:'OpenAI JSON helper unavailable'};const prompt=['You are a bank-statement totals extractor. Return JSON only.','Bank hint: '+bank+'.','Extract only figures explicitly printed on the statement. Never estimate.','Return statement_start_date, statement_end_date, opening_balance, closing_balance, total_deposits, total_withdrawals, page_credit_subtotals, page_debit_subtotals.','If page subtotals exist, return ALL of them. Do not use monthly average balance, minimum balance, transaction amounts or running balances as totals.','Known period: '+String(row.statementStartDate||'')+' to '+String(row.statementEndDate||''),'OCR TEXT:',String(text||'').substring(0,60000)].join('\n');const r=callOpenAIJson_(prompt)||{},credits=vfcBiqNumberArray_(r.page_credit_subtotals),debits=vfcBiqNumberArray_(r.page_debit_subtotals);let dep=vfcBiqNullablePositiveNumber_(r.total_deposits),wd=vfcBiqNullablePositiveNumber_(r.total_withdrawals);if((dep===null||dep===0)&&credits.length)dep=vfcBiqSum_(credits);if((wd===null||wd===0)&&debits.length)wd=vfcBiqSum_(debits);return vfcBiqReconcileTotals_({statementStartDate:r.statement_start_date||row.statementStartDate,statementEndDate:r.statement_end_date||row.statementEndDate,openingBalance:r.opening_balance!==undefined?r.opening_balance:row.openingBalance,closingBalance:r.closing_balance!==undefined?r.closing_balance:row.closingBalance,totalDeposits:dep,totalWithdrawals:wd,pageCreditSubtotals:credits,pageDebitSubtotals:debits});}
function vfcBiqReconcileTotals_(x){const o=vfcBiqNullableNumber_(x&&x.openingBalance),c=vfcBiqNullableNumber_(x&&x.closingBalance),d=vfcBiqNullablePositiveNumber_(x&&x.totalDeposits),w=vfcBiqNullablePositiveNumber_(x&&x.totalWithdrawals);if(o===null||c===null||d===null||w===null)return{verified:false,reason:'all four balance fields are required'};const diff=Math.abs(o+d-w-c);if(diff>VFC_BANKING_INPUT_CONFIG.RECONCILE_TOLERANCE_DOLLARS)return{verified:false,reason:'balance reconciliation differs by $'+vfcBiqRound_(diff,.01)};return{verified:true,statementStartDate:vfcBiqIsoDate_(x.statementStartDate),statementEndDate:vfcBiqIsoDate_(x.statementEndDate),openingBalance:vfcBiqRound_(o,.01),closingBalance:vfcBiqRound_(c,.01),totalDeposits:vfcBiqRound_(d,.01),totalWithdrawals:vfcBiqRound_(w,.01),reconciliationDifference:vfcBiqRound_(diff,.01),pageCreditSubtotals:x.pageCreditSubtotals||[],pageDebitSubtotals:x.pageDebitSubtotals||[]};}

function vfcBiqParseTdCandidates_(text,row){const out=[],start=vfcBiqDate_(row.statementStartDate),end=vfcBiqDate_(row.statementEndDate);String(text||'').split(/\r?\n/).forEach(function(raw){const line=String(raw||'').replace(/\u00a0/g,' ').replace(/\s+/g,' ').trim();if(!line||/BALANCE FORWARD|MONTHLY AVER|MONTHLY MIN|NEXT STATEMENT|\bCredits\b|\bDebits\b/i.test(line))return;const dm=line.match(/\b(JAN|FEB|MAR|APR|MAY|JUN|JUL|AUG|SEP|SEPT|OCT|NOV|DEC)\s*([0-3]?\d)\b/i);if(!dm)return;const prefix=line.substring(0,dm.index||0).trim(),money=[];let m,re=/([0-9][0-9,]*\.\d{2})/g;while((m=re.exec(prefix))!==null)money.push({value:m[1],index:m.index});if(!money.length)return;const t=money[money.length-1],amount=vfcBiqPositiveNumber_(t.value),desc=prefix.substring(0,t.index).trim().replace(/^[-|\s]+/,'').replace(/\s+/g,' '),cat=vfcBiqClassifyTransactionDescription_(desc,amount),date=vfcBiqResolveTransactionDate_(dm[1],dm[2],start,end);if(desc&&amount>0&&cat&&date)out.push({date:vfcBiqIsoDate_(date),description:desc.substring(0,160),counterparty:desc.substring(0,100),amount:vfcBiqRound_(amount,.01),category:cat,confidence:cat==='OTHER_RECURRING'?'Moderate':'High'});});return out;}
function vfcBiqClassifyTransactionDescription_(d,amount){const s=String(d||'').toUpperCase();if(/\bFEE\b|SERVICE\s+CHRG|SERVICE\s+CHARGE|MONTHLY\s+PLAN|NSF|RETURN\s+FEE|PAYMENT\s+COVERAGE/i.test(s))return'';if(/\bCRA\b|\bCCRA\b|GST-P|\bGST\b|\bHST\b|SOURCE\s+D|\bTAX\b|\bWCB\b|\bEMPTX\b|\bTXBAL\b/i.test(s))return'TAX_GOVERNMENT';if(/\bIPFS\b|PREMIUM\s+FIN|INSURANCE\s+FIN|\bINSURANCE\b/i.test(s))return'INSURANCE_FINANCE';if(/CREDIT\s+CARD\s+PAYMENT|C\/C\s+PAYMENT/i.test(s))return'CREDIT_CARD';if(/\bMCA\b|MERCHANT\s+CASH\s+ADVANCE/i.test(s))return'MCA';if(/TRUCK\s*FIN|TRUCKFIN/i.test(s))return'TRUCK_FINANCE';if(/\bAUTO\s+FIN|\bVEHICLE\s+FIN|FORD\s+CREDIT|CREDIT\s+CA\s+(?:APY|PAY|PAA)/i.test(s))return'AUTO_FINANCE';if(/\bLINE\s+OF\s+CREDIT\b|\bLOC\b/i.test(s))return'LOC';if(/\bLEASE\b/i.test(s))return'LEASE_FINANCE';if(/\bLOAN\b|LOAN\s+PYMT|LOAN\s+PAYMENT/i.test(s))return'TERM_LOAN';if(/\bFINANC(?:E|IAL|ING)\b/i.test(s))return'OTHER_FINANCING_PAYMENT';if(/\bPAD\b|PRE[- ]?AUTH(?:ORIZED)?|PREAUTHORIZED/i.test(s))return amount>=50?'RECURRING_PAD':'';if(/\bRLS\b|\bBUS\b\s*$/i.test(s))return'OTHER_RECURRING';return'';}

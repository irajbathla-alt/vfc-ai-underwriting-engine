function vfcStableCol_(h,w){const i=vfcStableColOpt_(h,w);if(i<0)throw new Error('Missing required column: '+w);return i;}
function vfcStableColOpt_(h,w){const t=String(w||'').toLowerCase().replace(/[^a-z0-9]/g,'');for(let i=0;i<h.length;i++)if(String(h[i]||'').toLowerCase().replace(/[^a-z0-9]/g,'')===t)return i;return-1;}
function vfcStableConf_(v){const t=String(v||'').trim().toLowerCase();return t==='high'?'High':t==='low'?'Low':'Moderate';}
function vfcStableArr_(v){return Array.isArray(v)?v.map(vfcStablePos_).filter(x=>isFinite(x)&&x>=0):[];}
function vfcStableDate_(v){if(!v)return null;const d=v instanceof Date?v:new Date(v);return isNaN(d.getTime())?null:d;}
function vfcStableIso_(v){const d=vfcStableDate_(v);return d?Utilities.formatDate(d,'UTC','yyyy-MM-dd'):'';}
function vfcStableNullNum_(v){if(v===''||v===null||v===undefined)return null;const t=String(v).trim();if(!t)return null;let n=vfcStableNum_(t);if(/OD$/i.test(t))n=-Math.abs(n);return isFinite(n)?n:null;}
function vfcStableNullPos_(v){const n=vfcStableNullNum_(v);return n!==null&&n>=0?n:null;}
function vfcStableNum_(v){if(typeof v==='number')return isFinite(v)?v:0;const n=parseFloat(String(v||'').replace(/[^0-9.\-]/g,''));return isFinite(n)?n:0;}
function vfcStablePos_(v){return Math.max(0,vfcStableNum_(v));}
function vfcStableRound_(v,s){const i=vfcStableNum_(s)||1;return Math.round(vfcStableNum_(v)/i)*i;}
function vfcStableSum_(a){return(a||[]).reduce((s,x)=>s+vfcStableNum_(x),0);}
function vfcStableMedian_(a){const n=(a||[]).map(vfcStableNum_).filter(x=>isFinite(x)&&x>=0).sort((a,b)=>a-b);if(!n.length)return 0;const m=Math.floor(n.length/2);return n.length%2?n[m]:(n[m-1]+n[m])/2;}
function vfcStableCv_(a){const n=(a||[]).map(vfcStableNum_).filter(x=>x>=0);if(!n.length)return 1;const avg=vfcStableSum_(n)/n.length;if(!avg)return 1;return Math.sqrt(n.reduce((s,x)=>s+Math.pow(x-avg,2),0)/n.length)/avg;}
function vfcStableTrend_(a){const n=(a||[]).map(vfcStableNum_);if(n.length<2)return 0;const sp=Math.max(1,Math.floor(n.length/2)),f=n.slice(0,sp),s=n.slice(sp),fa=vfcStableSum_(f)/f.length,sa=s.length?vfcStableSum_(s)/s.length:fa;return fa>0?(sa-fa)/fa:0;}
function vfcStableSame_(a,b){return String(a==null?'':a).trim().toLowerCase()===String(b==null?'':b).trim().toLowerCase();}
function vfcStableTime_(v){const d=vfcStableDate_(v);return d?d.getTime():0;}

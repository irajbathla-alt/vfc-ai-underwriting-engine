function vfcParse_(raw){raw=String(raw||'').trim();const p=[VFC_BANKING_PURE.PREFIX].concat(VFC_BANKING_PURE.LEGACY);for(let i=0;i<p.length;i++)if(raw.indexOf(p[i])===0)try{return JSON.parse(raw.slice(p[i].length));}catch(e){return null;}return null;}
function vfcUsable_(p,recent){return !!p&&p.openingBalance!==null&&p.closingBalance!==null&&p.totalDeposits!==null&&p.totalWithdrawals!==null&&p.totalDeposits>=0&&p.totalWithdrawals>=0&&p.reconciliationDifference!==null&&Math.abs(vfcNum_(p.reconciliationDifference))<=VFC_BANKING_PURE.TOL&&(!recent||p.transactionsVerified&&Array.isArray(p.transactions));}
function vfcTotals_(r){if(r.opening===null||r.closing===null||r.deposits===null||r.withdrawals===null)return{ok:false};const diff=vfcRound_((r.opening+r.deposits-r.withdrawals)-r.closing,.01);return{ok:Math.abs(diff)<=VFC_BANKING_PURE.TOL,o:r.opening,c:r.closing,d:r.deposits,w:r.withdrawals,diff:diff};}
function vfcReq_(x,p){if(typeof x==='string')return{companyName:x.trim(),period:String(p||'').trim()};x=x||{};return{companyName:String(x.companyName||x.company||'').trim(),period:String(x.period||p||'').trim()};}
function vfcHdr_(v){return String(v||'').trim().toLowerCase().replace(/[^a-z0-9]+/g,'');}
function vfcSame_(a,b){return vfcNorm_(a)===vfcNorm_(b);}
function vfcNorm_(v){return String(v||'').trim().toLowerCase().replace(/\s+/g,' ');}
function vfcNull_(v){if(v===null||v===undefined||String(v).trim()==='')return null;const n=vfcNum_(v);return isFinite(n)?n:null;}
function vfcNum_(v){if(typeof v==='number')return isFinite(v)?v:0;const n=parseFloat(String(v||'').replace(/[^0-9.\-]/g,''));return isFinite(n)?n:0;}
function vfcBool_(v){return /yes|true|detected|negative|1/i.test(String(v||''));}
function vfcRound_(v,s){s=s||1;return Math.round((Number(v)||0)/s)*s;}
function vfcDate_(v){if(!v)return null;const d=new Date(v);return isNaN(d.getTime())?null:d;}
function vfcIso_(v){const d=vfcDate_(v);return d?Utilities.formatDate(d,Session.getScriptTimeZone(),'yyyy-MM-dd'):'';}
function vfcTime_(v){const d=vfcDate_(v);return d?d.getTime():0;}
function vfcMedian_(a){if(!a.length)return 0;const m=Math.floor(a.length/2);return a.length%2?a[m]:(a[m-1]+a[m])/2;}
function vfcSum_(a){return(a||[]).reduce((s,t)=>s+vfcNum_(t.amount),0);}
function vfcLatestStatement_(rows){let d=null;(rows||[]).forEach(x=>{const z=vfcDate_(x.payload.statementEndDate||x.row.endDate);if(z&&(!d||z>d))d=z;});return d?vfcIso_(d):'';}
function vfcLatest_(items){const a=items.map(t=>vfcDate_(t.date)).filter(Boolean).sort((x,y)=>x-y);return a.length?vfcIso_(a[a.length-1]):'';}
function vfcDays_(a,b){const x=vfcDate_(a),y=vfcDate_(b);return x&&y?Math.abs(y-x)/86400000:0;}
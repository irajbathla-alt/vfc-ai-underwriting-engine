function vfcBankPos_(v){return Math.max(0,vfcBankNum_(v));}
function vfcBankRound_(v,s){const i=vfcBankNum_(s)||1;return Math.round(vfcBankNum_(v)/i)*i;}
function vfcBankSum_(a){return(a||[]).reduce((s,x)=>s+vfcBankNum_(x),0);}
function vfcBankMedian_(a){const n=(a||[]).map(vfcBankNum_).filter(x=>isFinite(x)&&x>=0).sort((a,b)=>a-b);if(!n.length)return 0;const m=Math.floor(n.length/2);return n.length%2?n[m]:(n[m-1]+n[m])/2;}
function vfcBankCv_(a){const n=(a||[]).map(vfcBankNum_).filter(x=>x>=0);if(!n.length)return 1;const avg=vfcBankSum_(n)/n.length;if(!avg)return 1;return Math.sqrt(n.reduce((s,x)=>s+Math.pow(x-avg,2),0)/n.length)/avg;}
function vfcBankTrend_(a){const n=(a||[]).map(vfcBankNum_);if(n.length<2)return 0;const sp=Math.max(1,Math.floor(n.length/2)),f=n.slice(0,sp),s=n.slice(sp),fa=vfcBankSum_(f)/f.length,sa=s.length?vfcBankSum_(s)/s.length:fa;return fa>0?(sa-fa)/fa:0;}
function vfcBankSame_(a,b){return String(a==null?'':a).trim().toLowerCase()===String(b==null?'':b).trim().toLowerCase();}
function vfcBankTime_(v){const d=vfcBankDate_(v);return d?d.getTime():0;}
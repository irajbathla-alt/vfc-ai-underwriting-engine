function bNormTx(items){if(!Array.isArray(items))return[];const out=[];items.forEach(x=>{x=x||{};const date=bIso(x.date),desc=String(x.description||'').replace(/\s+/g,' ').trim(),dir=String(x.direction||'').toUpperCase(),amount=Math.max(0,bNum(x.amount));if(!date||!desc||(dir!=='DEBIT'&&dir!=='CREDIT')||!(amount>0))return;const t={date:date,description:desc.substring(0,240),counterparty:String(x.counterparty||desc).replace(/\s+/g,' ').trim().substring(0,140),direction:dir,amount:bRound(amount,.01)},aliases=Array.isArray(x._aliases)?x._aliases:(Array.isArray(x.printedDescriptions)?x.printedDescriptions:[]);if(aliases.length)t._aliases=aliases.map(bLabel).filter(Boolean);out.push(t);});return out;}
function bUploads(){const rows=typeof getSheetObjects_==='function'?getSheetObjects_('Uploads'):[],x={id:{},cf:{},f:{}};rows.forEach(r=>{let id=String(r.fileId||'').trim(),link=String(r.fileLink||'');if(!id&&link){const m=link.match(/[-\w]{20,}/);if(m)id=m[0];}if(!id)return;const u={fileId:id,createdAt:r.createdAt||''},uid=String(r.uploadId||'').trim(),cf=bNorm(r.companyName)+'|'+bNorm(r.fileName),f=bNorm(r.fileName);if(uid)x.id[uid]=u;bNewest(x.cf,cf,u);bNewest(x.f,f,u);});return x;}function bResolve(r,x){return x.id[r.uploadId]||x.cf[bNorm(r.companyName)+'|'+bNorm(r.fileName)]||x.f[bNorm(r.fileName)]||null;}function bNewest(m,k,x){if(!k)return;const o=m[k];if(!o||bTime(x.createdAt)>=bTime(o.createdAt))m[k]=x;}
function bTotals(r){const o=r.opening,c=r.closing,d=r.deposits,w=r.withdrawals;if(o===null||c===null||d===null||w===null||d<0||w<0)return{ok:false};const diff=bRound(o+d-w-c,.01);return{ok:Math.abs(diff)<=VFC_BANKING.TOL,o:o,c:c,d:d,w:w,diff:diff};}function bParse(raw){raw=String(raw||'').trim();const p=[VFC_BANKING.PREFIX].concat(VFC_BANKING.LEGACY);for(let i=0;i<p.length;i++)if(raw.indexOf(p[i])===0)try{return JSON.parse(raw.slice(p[i].length));}catch(e){return null;}return null;}
function bActivityDate(day,mon,start,end){const mm={JAN:0,FEB:1,MAR:2,APR:3,MAY:4,JUN:5,JUL:6,AUG:7,SEP:8,OCT:9,NOV:10,DEC:11},mi=mm[String(mon||'').toUpperCase()];if(mi===undefined)return'';const s=bDate(start),e=bDate(end);let y=e?e.getFullYear():(s?s.getFullYear():new Date().getFullYear());if(s&&e&&s.getFullYear()!==e.getFullYear()&&mi>=s.getMonth())y=s.getFullYear();return bIso(new Date(y,mi,Number(day)));}
function bReq(x,p){if(typeof x==='string')return{companyName:String(x).trim(),period:String(p||'').trim()};x=x||{};return{companyName:String(x.companyName||x.company||'').trim(),period:String(x.period||p||'').trim()};}function bStmtKey(r){const s=bIso(r.startDate),e=bIso(r.endDate);return s&&e?s+'|'+e:bNorm(r.fileName);}function bHdr(v){return String(v||'').trim().toLowerCase().replace(/[^a-z0-9]+/g,'');}function bNorm(v){return String(v||'').trim().toLowerCase().replace(/\s+/g,' ');}function bSame(a,b){return bNorm(a)===bNorm(b);}function bNull(v){if(v===null||v===undefined||String(v).trim()==='')return null;const n=bNum(v);return isFinite(n)?n:null;}function bNum(v){if(typeof v==='number')return isFinite(v)?v:0;const n=parseFloat(String(v||'').replace(/[^0-9.\-]/g,''));return isFinite(n)?n:0;}function bBool(v){return/yes|true|detected|negative|1/i.test(String(v||''));}function bRound(v,s){s=s||1;return Math.round((Number(v)||0)/s)*s;}function bDate(v){if(!v)return null;const d=new Date(v);return isNaN(d.getTime())?null:d;}function bIso(v){const d=bDate(v);return d?Utilities.formatDate(d,Session.getScriptTimeZone(),'yyyy-MM-dd'):'';}function bTime(v){const d=bDate(v);return d?d.getTime():0;}function bMedian(a){if(!a.length)return 0;const m=Math.floor(a.length/2);return a.length%2?a[m]:(a[m-1]+a[m])/2;}function bSum(a){return(a||[]).reduce((s,t)=>s+bNum(t.amount),0);}function bClose(a,b,p,d){a=bNum(a);b=bNum(b);return Math.abs(a-b)<=Math.max(d||0,Math.max(a,b)*(p||0));}function bLabel(v){return String(v||'').replace(/\s+/g,' ').trim();}function bPeriods(a){const s={};a.forEach(t=>{if(t._statementKey)s[t._statementKey]=1;else if(t._statementIndex!==undefined)s[String(t._statementIndex)]=1;else if(/^\d{4}-\d{2}/.test(t.date))s[t.date.slice(0,7)]=1;});return Object.keys(s).length;}function bFirst(a){let x=null;a.forEach(t=>{const i=Number(t._statementIndex);if(isFinite(i)&&(x===null||i<x))x=i;});return x===null?0:x;}function bLatestStmt(rows){let x=null;rows.forEach(r=>{const d=bDate(r.payload.statementEndDate||r.row.endDate);if(d&&(!x||d>x))x=d;});return x?bIso(x):'';}function bLatest(a){const d=a.map(t=>bDate(t.date)).filter(Boolean).sort((x,y)=>x-y);return d.length?bIso(d[d.length-1]):'';}function bDays(a,b){const x=bDate(a),y=bDate(b);return!x||!y?0:Math.abs(y-x)/86400000;}
